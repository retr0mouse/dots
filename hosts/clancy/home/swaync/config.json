{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-positionX": "left",
  "control-center-positionY": "top",
  "control-center-layer": "top",
  "control-center-exclusive-zone": true,
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 0,
  "control-center-margin-left": 8,
  "control-center-width": 440,
  "control-center-height": 760,
  "notification-window-width": 420,
  "notification-window-height": -1,
  "fit-to-screen": false,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "no notifications",
  "script-fail-notify": true,
  "widgets": [
    "menubar#header",
    "volume",
    "backlight",
    "mpris",
    "inhibitors",
    "title#notifications",
    "notifications"
  ],
  "widget-config": {
    "menubar#header": {
      "buttons#identity": {
        "position": "left",
        "actions": [
          {
            "label": "[ nixos ]",
            "command": ""
          }
        ]
      },
      "buttons#power": {
        "position": "right",
        "actions": [
          {
            "label": "󰐥",
            "command": "sh -c 'swaync-client --close-panel; session-menu'"
          }
        ]
      }
    },
    "volume": {
      "label": "",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰍹",
      "device": "amdgpu_bl2",
      "subsystem": "backlight",
      "min": 1
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true,
      "blacklist": [],
      "loop-carousel": false
    },
    "title#notifications": {
      "text": "[ notifications ]",
      "clear-all-button": true,
      "button-text": "clear"
    },
    "inhibitors": {
      "text": "[ inhibitors ]",
      "clear-all-button": true,
      "button-text": "clear"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
